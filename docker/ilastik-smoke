    test -s "$output"

    (umask 000; exec ilastik-gui --project "$project" --bind-address 127.0.0.1 \
      --port 5817 --vnc-port 5917 --display :17 --geometry 1000x720 \
      --startup-timeout 150) >"$tmp/session.log" 2>&1 &
    pid=$!
    i=0
    until grep -F 'ilastik GUI is starting.' "$tmp/session.log" >/dev/null; do
        kill -0 "$pid" 2>/dev/null || { cat "$tmp/session.log" >&2; exit 1; }
