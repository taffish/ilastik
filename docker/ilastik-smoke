    grep -Fx 'upstream_commit=cfcb94fcfdb83ddd0f85e322173f6549f760e653' /usr/share/ilastik-taffish/source.txt >/dev/null
    grep -Fx 'archive_sha256=164facabba4b1103a98d806c156f70937136bee0363aeeae84df6dade1e6763f' /usr/share/ilastik-taffish/source.txt >/dev/null
    test -s /opt/ilastik/ilastik-1.4.2-Linux.yaml
