runtime_closure() {
    python - <<'PY'
import os

os.environ["NUMBA_THREADING_LAYER"] = "tbb"

import imagecodecs
import numpy as np
from elf.segmentation.watershed import distance_transform_watershed
from numba import njit, prange, threading_layer

raw = np.arange(256, dtype=np.uint16).tobytes()
assert imagecodecs.zlib_decode(imagecodecs.zlib_encode(raw)) == raw

probabilities = np.zeros((32, 32), dtype=np.float32)
probabilities[4:12, 4:12] = 1
probabilities[20:28, 20:28] = 1
segmentation, max_id = distance_transform_watershed(
    probabilities, threshold=0.5, sigma_seeds=1.0
)
assert segmentation.shape == probabilities.shape
assert max_id >= 2

@njit(parallel=True)
def parallel_sum(values):
    total = 0
    for index in prange(values.size):
        total += values[index]
    return total

values = np.arange(256, dtype=np.int64)
assert parallel_sum(values) == values.sum()
assert threading_layer() == "tbb"
print("ilastik runtime closure ok")
PY
}

make_input() {
    make_input_output="$1"
    python - "$make_input_output" <<'PY'
