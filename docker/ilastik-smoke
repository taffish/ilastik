run_conversion() {
    conversion_input="$1"
    conversion_project="$2"
    conversion_output="$3"
    conversion_log="$4"
    ilastik --headless \
      "--new_project=$conversion_project" \
      --workflow=DataConversionWorkflow \
      --output_format=hdf5 \
      "--output_filename_format=$conversion_output" \
      --input_axes=yxc \
      "$conversion_input" >"$conversion_log" 2>&1
}

data_conversion() {
    tmp="$(mktemp -d /tmp/taf-ilastik-conversion.XXXXXX)"
    mkdir -p "$tmp"
    input="$tmp/input image.npy"
    project="$tmp/conversion project.ilp"
    output="$tmp/converted image.h5"
    make_input "$input"
    run_conversion "$input" "$project" "$output" "$tmp/run.log"
    test -s "$project"
    test -s "$output"
    grep -F 'Completed Batch Processing' "$tmp/run.log" >/dev/null
    python - "$project" "$output" <<'PY'
import sys
import h5py

project, output = sys.argv[1:]
with h5py.File(project, "r") as handle:
    assert handle["ilastikVersion"][()].decode() == "1.4.2"
    assert handle["workflowName"][()].decode() == "Data Conversion"
with h5py.File(output, "r") as handle:
    datasets = []
    handle.visititems(lambda name, obj: datasets.append(obj) if isinstance(obj, h5py.Dataset) else None)
    assert datasets
    assert datasets[0].size == 32 * 32
PY
}

