    test -s /usr/share/doc/ilastik-upstream/CITATION.cff
    test -s /usr/share/ilastik-taffish/source.txt
    python -c 'import astropy, ilastik, lazyflow, pyshtools; assert ilastik.__version__ == "1.4.2"'
}

