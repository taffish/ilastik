    runtime_log_dir="$(awk '/Internal session logs:/{getline; gsub(/^[[:space:]]+/, ""); print; exit}' "$tmp/session.log")"
    test -d "$runtime_log_dir"
    test "$(stat -c '%a' "$runtime_log_dir")" = 700
    test "$(stat -c '%a' "$runtime_log_dir/runtime")" = 700
    test "$(stat -c '%a' "$runtime_log_dir/application-runtime")" = 700
    test -s "$runtime_log_dir/window-layout.log"
    grep -Fx 'RFB ready: 3.8 security=none framebuffer=1000x720' "$runtime_log_dir/rfb-readiness.log" >/dev/null
    /usr/bin/python3 /usr/share/ilastik-taffish/rfb-probe.py 5917 1000 720
    python - "$runtime_log_dir/processes.tsv" <<'PY'
from pathlib import Path
import sys
processes = dict(line.split('\t') for line in Path(sys.argv[1]).read_text().splitlines())
def limits(pid):
    line = next(line for line in Path('/proc', pid, 'limits').read_text().splitlines()
                if line.startswith('Max open files'))
    return line.split()[3:5]
parent_soft, parent_hard = limits(processes['helper'])
vnc_soft, vnc_hard = limits(processes['x11vnc'])
assert int(vnc_soft) <= 1024
assert vnc_hard == parent_hard
assert parent_soft == 'unlimited' or int(vnc_soft) == min(int(parent_soft), 1024)
assert limits(processes['ilastik']) == [parent_soft, parent_hard]
print('VNC-only nofile cap; main application limits preserved')
