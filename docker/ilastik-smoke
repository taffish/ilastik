    grep -F 'RFB=false' "$tmp/session.log" >/dev/null
    grep -F 'RFB not ready:' "$tmp/session.log" >/dev/null
    grep -F 'injected live VNC without RFB handshake' "$tmp/session.log" >/dev/null
    test ! -S /tmp/.X11-unix/X21
}

gui_log_permissions() {
    tmp="$(mktemp -d /tmp/taf-ilastik-gui-permissions.XXXXXX)"
    mkdir -p "$tmp/bin" "$tmp/foreign"
    printf 'untouched\n' >"$tmp/foreign/sentinel"
    cat >"$tmp/bin/Xvfb" <<'SH'
#!/bin/sh
log_root="$(dirname "$(readlink "/proc/$$/fd/1")")"
test "$(stat -c '%a' "$log_root")" = 700 || exit 98
test "$(stat -c '%a' "$log_root/runtime")" = 700 || exit 99
printf 'private log root before first child; inherited umask=%s\n' "$(umask)"
exit 42
SH
    chmod 0755 "$tmp/bin/Xvfb"
    previous_log_root=
    for caller_mask in 000 077; do
        status=0
        PATH="$tmp/bin:$PATH" sh -c '
          umask "$1"
          legacy="/tmp/ilastik-gui-$$"
          ln -s "$2/foreign" "$legacy"
          printf "%s\n" "$legacy" >"$2/legacy-path"
          exec ilastik-gui --display :24 --startup-timeout 2
        ' gui-permissions "$caller_mask" "$tmp" >"$tmp/session-$caller_mask.log" 2>&1 || status=$?
        test "$status" -eq 1
        runtime_log_dir="$(awk '/Internal session logs:/{getline; gsub(/^[[:space:]]+/, ""); print; exit}' "$tmp/session-$caller_mask.log")"
        case "$runtime_log_dir" in /tmp/ilastik-gui.*) ;; *) exit 1 ;; esac
        test "$runtime_log_dir" != "$previous_log_root"
        test ! -L "$runtime_log_dir"
        test "$(stat -c '%a' "$runtime_log_dir")" = 700
        test "$(stat -c '%u' "$runtime_log_dir")" = "$(id -u)"
        grep -F 'private log root before first child' "$runtime_log_dir/xvfb.log" >/dev/null
        grep -E "inherited umask=0*$caller_mask$" "$runtime_log_dir/xvfb.log" >/dev/null
        legacy="$(cat "$tmp/legacy-path")"
        test -L "$legacy"
        test "$(readlink "$legacy")" = "$tmp/foreign"
        grep -Fx untouched "$tmp/foreign/sentinel" >/dev/null
        test "$(find "$tmp/foreign" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1
        rm -- "$legacy"
        previous_log_root="$runtime_log_dir"
    done
}

xvfb_forced_cleanup() {
    tmp="$(mktemp -d /tmp/taf-ilastik-xvfb-cleanup.XXXXXX)"
    mkdir -p "$tmp/bin"
    cat >"$tmp/bin/Xvfb" <<'PY'
#!/usr/bin/python3
import os
from pathlib import Path
import signal
import socket
import sys
import time
number = sys.argv[1].removeprefix(':')
signal.signal(signal.SIGTERM, signal.SIG_IGN)
with socket.socket(socket.AF_UNIX) as listener:
    Path('/tmp/.X' + number + '-lock').write_text(str(os.getpid()) + '\n')
    listener.bind('/tmp/.X11-unix/X' + number)
    listener.listen(4)
    print('injected Xvfb: ignores TERM and leaves owned endpoints on KILL', flush=True)
    while True:
        time.sleep(1)
PY
    printf '%s\n' '#!/bin/sh' 'exit 42' >"$tmp/bin/twm"
    chmod 0755 "$tmp/bin/Xvfb" "$tmp/bin/twm"
    status=0
    PATH="$tmp/bin:$PATH" ilastik-gui --bind-address 127.0.0.1 \
      --port 5823 --vnc-port 5923 --display :23 --geometry 1000x720 \
      --startup-timeout 4 >"$tmp/session.log" 2>&1 || status=$?
    printf 'forced Xvfb cleanup helper status=%s\n' "$status"
    test "$status" -eq 1
    ! grep -F 'ilastik GUI is ready.' "$tmp/session.log" >/dev/null
    test ! -e /tmp/.X11-unix/X23
    test ! -e /tmp/.X23-lock
    runtime_log_dir="$(awk '/Internal session logs:/{getline; gsub(/^[[:space:]]+/, ""); print; exit}' "$tmp/session.log")"
    grep -F 'injected Xvfb: ignores TERM' "$runtime_log_dir/xvfb.log" >/dev/null
    xvfb_pid="$(awk -F '\t' '$1 == "Xvfb" {print $2}' "$runtime_log_dir/processes.tsv")"
    case "$xvfb_pid" in ''|*[!0-9]*|0|1) exit 1 ;; esac
    ! kill -0 "$xvfb_pid" 2>/dev/null
}

case "$mode" in
    buildtime) buildtime ;;
    identity) identity ;;
    modules) modules ;;
    runtime-closure) runtime_closure ;;
    data-conversion) data_conversion ;;
    model-contract) model_contract ;;
    model-fixture) model_fixture ;;
    model-download) python /usr/share/ilastik-taffish/model-download-test.py ;;
