model_fixture() {
    tmp="$(mktemp -d /tmp/taf-ilastik-model-fixture.XXXXXX)"
    root="$tmp/prepared"
    mkdir -p "$tmp"
    python /usr/share/ilastik-taffish/model-fixture.py "$tmp"
    archive_sha="$(sha256sum "$tmp/model.zip" | cut -d ' ' -f 1)"
    common="--model-id tiny-model --archive $tmp/model.zip --source https://example.invalid/tiny-model.zip --sha256 $archive_sha --model-root $root"
    # shellcheck disable=SC2086
    ilastik-models $common --dry-run >"$tmp/dry-run.log"
    grep -F 'license: CC0-1.0' "$tmp/dry-run.log" >/dev/null
    grep -F "archive_sha256: $archive_sha" "$tmp/dry-run.log" >/dev/null
    # shellcheck disable=SC2086
    ilastik-models $common \
      --confirm-authorized-local-import >"$tmp/install.log"
    ilastik-models \
      --model-root "$root" --verify-only >"$tmp/verify.log"
    ilastik-models \
      --model-root "$root" --inventory >"$tmp/inventory.tsv"
    grep -F 'tiny-model' "$tmp/inventory.tsv" >/dev/null
    test -s "$root/TAFFISH_MODEL_MANIFEST.json"
    test -s "$root/TAFFISH_MODEL_INVENTORY.tsv"
    test -s "$root/TAFFISH_MODEL_READY"
    test -s "$root/tiny-model/model.zip"
    test "$(stat -c '%a' "$root")" = 755
    test "$(stat -c '%a' "$root/tiny-model/model.zip")" = 644
    # shellcheck disable=SC2086
    ilastik-models $common \
      --confirm-authorized-local-import >"$tmp/idempotent.log"
    grep -F 'Already installed and verified' "$tmp/idempotent.log" >/dev/null
    python - "$root" <<'PY'
from pathlib import Path
import fcntl
import runpy
import sys
module = runpy.run_path('/usr/local/bin/ilastik-models')
root = Path(sys.argv[1])
# Retain the exact v1 schema, with r1 provenance and matching ready hashes.
for manifest_path, ready_path in (
    (root / '.taffish/models/tiny-model.json', root / '.taffish/models/tiny-model.ready'),
    (root / 'TAFFISH_MODEL_MANIFEST.json', root / 'TAFFISH_MODEL_READY'),
):
    manifest = module['read_json'](manifest_path, 'fixture manifest')
    manifest['prepared_by_app_release'] = '1.4.2-r1'
    module['atomic_write'](manifest_path, module['canonical_json'](manifest))
    ready = module['read_json'](ready_path, 'fixture ready')
    ready['manifest_sha256'] = module['sha256'](manifest_path)
    module['atomic_write'](ready_path, module['canonical_json'](ready))
module['verify_root'](root, thorough=True)
held = module['acquire_lock'](root)
try:
    try:
        module['acquire_lock'](root)
    except module['ModelError'] as error:
        assert 'another ilastik model installer' in str(error)
    else:
        raise AssertionError('concurrent lock was accepted')
finally:
    held.close()
print('r1 prepared-root reuse and concurrent lock rejection ok')
PY
    printf 'corruption' >>"$root/tiny-model/model.zip"
    status=0
    ilastik-models --model-root "$root" --verify-only \
      >"$tmp/corruption.log" 2>&1 || status=$?
    test "$status" -eq 1
    grep -F 'model archive size mismatch' "$tmp/corruption.log" >/dev/null
}

