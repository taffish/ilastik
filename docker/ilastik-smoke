    grep -F 'ssh -N -L 5817:127.0.0.1:5817 user@server' "$tmp/session.log" >/dev/null
    grep -F 'Press Ctrl-C to stop this GUI session.' "$tmp/session.log" >/dev/null

    i=0
    until curl -fsS http://127.0.0.1:5817/vnc.html >/dev/null 2>&1 \
      && grep -F 'ilastik GUI is ready.' "$tmp/session.log" >/dev/null; do
        kill -0 "$pid" 2>/dev/null || { cat "$tmp/session.log" >&2; exit 1; }
        i=$((i + 1)); [ "$i" -lt 165 ] || { cat "$tmp/session.log" >&2; exit 1; }
        sleep 1
    done

    starting_line="$(grep -n -m1 'ilastik GUI is starting.' "$tmp/session.log" | cut -d: -f1)"
    ready_line="$(grep -n -m1 'ilastik GUI is ready.' "$tmp/session.log" | cut -d: -f1)"
