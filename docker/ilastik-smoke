#!/bin/sh
set -eu

mode="${1:-}"
tmp=
pid=
smoke_home="$(mktemp -d /tmp/taf-ilastik-home.XXXXXX)"
export HOME="$smoke_home"

smoke_cleanup() {
    smoke_status=$?
    trap '' INT TERM HUP
    trap - EXIT
    set +e
    if [ "$smoke_status" -ne 0 ]; then
        printf 'ilastik-smoke: stage=%s exit=%s\n' "$mode" "$smoke_status" >&2
        if [ -n "$tmp" ] && [ -d "$tmp" ]; then
            for smoke_log in "$tmp"/*.log; do
                [ -f "$smoke_log" ] || continue
                printf 'log: %s\n' "$smoke_log" >&2
                tail -n 60 "$smoke_log" >&2
            done
        fi
    fi
    case "$pid" in
        ''|*[!0-9]*|0|1) ;;
        *)
            if [ "$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)" = "$$" ]; then
                kill -TERM "$pid" 2>/dev/null
                sleep 7
                if [ "$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)" = "$$" ]; then
                    kill -KILL "$pid" 2>/dev/null
                fi
                wait "$pid" 2>/dev/null
            fi ;;
    esac
    case "$tmp" in /tmp/taf-ilastik-*) rm -rf -- "$tmp" ;; esac
    rm -rf -- "$smoke_home"
    [ "$smoke_status" -ne 0 ] || printf 'ilastik-smoke: stage=%s PASS\n' "$mode"
    exit "$smoke_status"
}
trap smoke_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

